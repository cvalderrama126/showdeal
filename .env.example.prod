# ============================================
# ShowDeal Production Environment
# ============================================
# DO NOT COMMIT ACTUAL VALUES TO GIT
# Copy this file to .env.production and fill with real values
# ============================================

# ============================================
# APPLICATION
# ============================================
NODE_ENV=production
PORT=3001
LOG_LEVEL=info
ENABLE_DEBUG_ERRORS=0

# ============================================
# DATABASE
# ============================================
# PostgreSQL Connection String
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://showdeal_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/showdeal_prod

# Database Credentials (for docker-compose)
POSTGRES_DB=showdeal_prod
POSTGRES_USER=showdeal_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Backup Configuration
DB_BACKUP_PATH=/backups
DB_BACKUP_SCHEDULE=0 2 * * *  # 2 AM daily

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
# JWT Configuration
JWT_SECRET=CHANGE_ME_VERY_LONG_RANDOM_STRING_MIN_32_CHARS
JWT_EXPIRE=86400  # 24 hours in seconds

# OTP Configuration
OTP_ISSUER=ShowDeal
OTP_WINDOW=1  # Accept codes within 1 window
OTP_REPLAY_TTL_SECONDS=30

# ============================================
# REDIS (Cache & Session Store)
# ============================================
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_TTL=3600  # 1 hour

# ============================================
# EMAIL (SMTP)
# ============================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=CHANGE_ME_SENDGRID_API_KEY
SMTP_FROM=noreply@showdeal.com
SMTP_REPLYTO=support@showdeal.com

# ============================================
# CORS & SECURITY
# ============================================
CORS_ORIGIN=https://showdeal.com,https://www.showdeal.com
CORS_CREDENTIALS=true

# CSRF Protection
CSRF_COOKIE_SECURE=true
CSRF_COOKIE_HTTPONLY=true
CSRF_COOKIE_SAMESITE=Strict

# ============================================
# FILE UPLOADS
# ============================================
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_PATH=/app/uploads
ALLOWED_EXTENSIONS=xlsx,xls,pdf,jpg,png,jpeg

# ============================================
# EXTERNAL INTEGRATIONS
# ============================================
# SendGrid API Key (also used for SMTP above)
SENDGRID_API_KEY=CHANGE_ME_SENDGRID_API_KEY

# Optional: Stripe for payments (if applicable)
STRIPE_SECRET_KEY=CHANGE_ME_STRIPE_KEY
STRIPE_PUBLISHABLE_KEY=CHANGE_ME_STRIPE_PUB_KEY

# ============================================
# MONITORING & LOGGING
# ============================================
# ELK Stack / Datadog
ELASTICSEARCH_URL=https://elasticsearch.example.com:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASS=CHANGE_ME_ELASTICSEARCH_PASS

# Datadog (alternative to ELK)
DATADOG_API_KEY=CHANGE_ME_DATADOG_KEY
DATADOG_SITE=datadoghq.com

# Sentry for error tracking
SENTRY_DSN=https://key@sentry.io/projectid

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=60000  # 1 minute
RATE_LIMIT_MAX_REQUESTS=100  # 100 requests per minute

# Auth endpoint specific (stricter)
AUTH_RATE_LIMIT_MAX=5  # 5 attempts per minute

# ============================================
# DEPLOYMENT & INFRASTRUCTURE
# ============================================
# Docker Registry
DOCKER_REGISTRY=docker.io
DOCKER_IMAGE=showdeal

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_SHUTDOWN_TIMEOUT=30000  # 30 seconds

# ============================================
# BACKUP & DISASTER RECOVERY
# ============================================
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_REMOTE_STORAGE=s3://backups-showdeal/  # Optional: S3 for off-site
AWS_ACCESS_KEY_ID=CHANGE_ME_IF_USING_S3
AWS_SECRET_ACCESS_KEY=CHANGE_ME_IF_USING_S3

# ============================================
# FEATURE FLAGS (Optional)
# ============================================
FEATURE_SEALED_BIDS=true
FEATURE_ROUND1_BULK_UPLOAD=true
FEATURE_AUCTION_RESOLUTION=true
FEATURE_REAL_TIME_UPDATES=false  # WebSocket features

# ============================================
# NOTES FOR DEPLOYMENT TEAM
# ============================================
# 1. Generate strong passwords:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 2. Update all CHANGE_ME_* values with actual credentials
#
# 3. Store secrets securely:
#    - Use AWS Secrets Manager / Azure Key Vault
#    - Or use encrypted environment config
#    - NEVER commit .env.production to git
#
# 4. Validate before deployment:
#    npm run validate:env
#
# 5. Keep backups of old .env files
#    for rollback procedures
