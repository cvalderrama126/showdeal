# Environment
.env
.env.*.local
.env.local

# Dependencies — VENDORED for fully offline installs.
# node_modules/ and package-lock.json are committed on purpose so that
# `npm install` never needs to reach the internet. See .npmrc (offline=true).
!node_modules/
yarn.lock
pnpm-lock.yaml
# Exclude transient Prisma engine download cache and temp files (not needed at runtime).
node_modules/.cache/
node_modules/**/*.tmp*

# Runtime data
dist/
build/
.next/
out/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
coverage/
.nyc_output/

# Build
prisma/client/
prisma/generated/

# Uploads
uploads/
temp/
tmp/

# OS
Thumbs.db
.env.prod

# Prisma
prisma/*.db
prisma/*.db-shm
prisma/*.db-wal
