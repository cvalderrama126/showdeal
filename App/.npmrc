# =============================================================================
# Fully OFFLINE dependency policy for ShowDeal.
#
# All dependencies (prod + dev) are vendored under node_modules/ and committed
# to the repository, together with package-lock.json. This guarantees that
# `npm install` NEVER reaches the internet.
#
# Usage after cloning:
#   - Just run the app: dependencies are already present in node_modules/.
#   - `npm install --offline`  -> verifies the tree without any network access.
#
# NOTE: avoid `npm ci`, which deletes node_modules and would require the npm
#       cache (not committed). With vendored modules you do not need it.
# =============================================================================
offline=true
audit=false
fund=false
package-lock=true
