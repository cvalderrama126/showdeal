# Application
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Database - PostgreSQL
DATABASE_URL="postgresql://showdeal:your_secure_password@localhost:5432/showdeal?schema=showdeal"

# Admin User Seed (Docker first run only)
ADMIN_EMAIL=admin@showdeal.com
ADMIN_FULL_NAME=Admin User
ADMIN_PHONE=+1-555-0000
# bcrypt hash — generate with: node -e "require('bcryptjs').hash('YourPassword',10).then(console.log)"
ADMIN_PASSWORD_HASH=$2a$10$N9qo8uLOickgx2ZMRZoMyeIjZAgcg7b3XeKeUxWdeS86E36P4JlFm

# JWT Authentication
JWT_SECRET="generate-a-random-secret-key-min-32-chars"
JWT_EXPIRES_IN="8h"

# JWT Challenge (OTP)
JWT_CHALLENGE_SECRET="generate-another-random-secret"
JWT_CHALLENGE_EXPIRES_IN="5m"

# File Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# Optional: Monitoring & Logging
# SENTRY_DSN="https://xxxxx@sentry.io/xxxxx"
# LOG_SERVICE="pino|basic"
