# ShowDeal - Configuración Docker Compose

# ============================================
# Application Configuration
# ============================================
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
APP_PORT=3000

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
DB_USER=showdeal
DB_PASSWORD=CHANGE_ME_BEFORE_USE
DB_NAME=showdeal
DB_PORT=5432

# ============================================
# Admin User Seed (first run only)
# ============================================
# Email and name for the initial admin user
ADMIN_EMAIL=admin@showdeal.com
ADMIN_FULL_NAME=Admin User
ADMIN_PHONE=+1-555-0000
# bcrypt hash — generate with: node -e "require('bcryptjs').hash('YourPassword',10).then(console.log)"
ADMIN_PASSWORD_HASH=CHANGE_ME_bcrypt_hash_of_your_admin_password

# ============================================
# JWT Authentication
# ============================================
# ⚠️ IMPORTANTE: Cambiar estos valores en producción!
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_with_node_crypto_randomBytes_32_hex
JWT_EXPIRES_IN=8h
JWT_CHALLENGE_SECRET=CHANGE_ME_generate_with_node_crypto_randomBytes_32_hex
JWT_CHALLENGE_EXPIRES_IN=5m

# ============================================
# File Upload Configuration
# ============================================
MAX_FILE_SIZE=10485760
# UPLOAD_DIR se configura en docker-compose.yml

# ============================================
# Redis Configuration (Caching)
# ============================================
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_BEFORE_USE

# ============================================
# Optional: Monitoring & Error Tracking
# ============================================
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
# ENVIRONMENT=development
# RELEASE=1.0.0

# ============================================
# Optional: Email Configuration
# ============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# ============================================
# Cors Configuration
# ============================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

